<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>DisplayAnchor</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.gabriarceus.DisplayAnchor</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>DisplayAnchor</string>
	<key>CFBundleName</key>
	<string>DisplayAnchor</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.1.0-rc1</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSUIElement</key>
	<true/>
	<!-- Sparkle. The feed is the appcast.xml asset of the newest release, so the
	     URL stays valid without a separate host. SUPublicEDKey is the public half
	     of the EdDSA pair from `.build/artifacts/sparkle/Sparkle/bin/generate_keys`;
	     an ad-hoc signed app cannot rotate it, so it is fixed once published. -->
	<key>SUFeedURL</key>
	<string>https://github.com/gabriarceus/DisplayAnchor/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>LgID/g/PYU/Is8BT0PwJ/KCvuUgJtyZ/0z60dB8DlZ4=</string>
	<!-- Set explicitly so Sparkle never asks on its own: the app has its own
	     "Check for updates automatically" toggle, which writes through to it. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>21600</integer>
</dict>
</plist>
